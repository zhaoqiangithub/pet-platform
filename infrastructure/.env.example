# 部署配置（敏感信息）
# 复制此文件为 .env 并填入实际值
# 注意: .env 已在 .gitignore 中，不会提交到版本库

# 服务器配置
DEPLOY_SERVER_IP=100.75.11.32
SSH_USER=root
SSH_PORT=22
SSH_KEY=~/.ssh/id_rsa
DEPLOY_SSH_PASSWORD=<your-ssh-password>

# Jenkins配置
JENKINS_PORT=8080
JENKINS_ADMIN_PASSWORD=<your-jenkins-password>

# HTTP 代理配置（解决 Git/Docker/NPM 网络访问问题）
# 如果 Jenkins 无法访问外网（如 GitHub、Docker Hub），需要配置代理
# 格式: http://<代理IP>:<代理端口>
HTTP_PROXY_HOST=<your-proxy-host>
HTTP_PROXY_PORT=<your-proxy-port>
# 完整代理 URL（通常不需要修改）
HTTP_PROXY=http://${HTTP_PROXY_HOST}:${HTTP_PROXY_PORT}
HTTPS_PROXY=http://${HTTP_PROXY_HOST}:${HTTP_PROXY_PORT}

# Harbor配置（未来使用）
HARBOR_URL=harbor.local
HARBOR_PROJECT=pet-platform
HARBOR_USER=admin
HARBOR_PASSWORD=<your-harbor-password>
